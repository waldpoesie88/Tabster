{
  "manifest_version": 3,
  "name": "Tabster: Smart Tab Suspender",
  "version": "1.5",
  "description": "Compact and smart RAM manager for browser tabs with YouTube timestamp saving, whitelist, and live search.",
  "permissions": ["tabs", "storage", "alarms", "scripting", "sidePanel"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tabster",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html?mode=sidepanel"
  }
}
